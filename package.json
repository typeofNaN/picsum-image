{
  "name": "picsum-image",
  "version": "1.0.5",
  "main": "./dist/picsum-image.cjs",
  "module": "./dist/picsum-image.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/picsum-image.js",
      "require": "./dist/picsum-image.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "author": {
    "name": "typeofNaN",
    "url": "https://github.com/typeofNaN",
    "email": "dmdefine6@gmail.com"
  },
  "homepage": "https://github.com/typeofNaN/picsum-image",
  "repository": {
    "type": "git",
    "url": "https://github.com/typeofNaN/picsum-image.git"
  },
  "bugs": {
    "url": "https://github.com/typeofNaN/picsum-image/issues"
  },
  "license": "MIT",
  "description": "快速生成picsum图片，适用于UI未提供图片时设置占位图。",
  "keywords": [
    "Picsum",
    "random-image",
    "随机图片",
    "占位图"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
